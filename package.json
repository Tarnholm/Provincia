{
  "name": "provincia",
  "version": "0.9.1318",
  "description": "Provincia — Rome: Total War mod data viewer",
  "author": "Tarnholm",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "vite",
    "bundle-data": "node scripts/bundle-mod-data.js",
    "fetch-runtime": "node scripts/fetch-runtime.js",
    "bundle-mac-demo": "node scripts/bundle-mac-demo.js",
    "prebuild": "node scripts/bundle-mod-data.js && node scripts/fetch-runtime.js",
    "build": "vite build",
    "test": "vitest run",
    "electron": "electron .",
    "electron-dev": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "ship": "node scripts/ship.js",
    "submit-fp": "node scripts/submit-false-positive.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "lz4js": "^0.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "vite": "^7.3.2",
    "vitest": "^4.1.4"
  },
  "build": {
    "extends": null,
    "beforeBuild": "scripts/clean-dist-installers.js",
    "appId": "com.example.interactive-map",
    "productName": "Provincia",
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "icon": "public/icon.ico",
    "files": [
      "build/**",
      "main.js",
      "preload.js",
      "main-scripts.js",
      "preload-scripts.js",
      "scripts-suite/**",
      "scripts/campaign-timeline.js",
      "package.json",
      "src/characterParser.js",
      "src/characterParserV2.js",
      "src/charactersWorker.js",
      "src/buildingsWorker.js",
      "src/messageLogParser.js",
      "src/unitParser.js",
      "src/buildingParser.js",
      "src/ownershipParser.js",
      "src/saveOwnershipParser.js",
      "src/factionRecordParser.js",
      "src/luaCounterParser.js",
      "src/queueParser.js",
      "src/saveCrackerExtras.js",
      "src/saveCracker.js",
      "src/calibSaveOpts.js",
      "src/tradeNetwork.js",
      "src/tileResolver.js",
      "src/familyRecordParser.js",
      "src/siegeParser.js",
      "src/eventLogParser.js",
      "src/settlementFieldsParser.js",
      "src/landmarkParser.js",
      "src/recruitPool.js",
      "src/armySetup.js",
      "src/growthModel.js",
      "src/growthEval.js",
      "src/incomeModel.js",
      "src/poModel.js",
      "src/traitEffects.js",
      "src/mercenaryParser.js",
      "src/eventScheduleParser.js",
      "src/visionParser.js",
      "src/factionKnowledgeParser.js",
      "src/descrStratGeneral.js",
      "src/pathSafety.js",
      "src/consentRoots.js",
      "src/saveBinaryReaders.js",
      "src/tgaCodec.js",
      "src/lastTurnSummary.js",
      "src/systemHandlers.js",
      "src/vanillaDataHandlers.js",
      "src/logHandlers.js",
      "src/buildingInfoHandlers.js",
      "src/iconHandlers.js",
      "src/portraitHandlers.js",
      "src/modEditingHandlers.js",
      "src/saveAnalysisHandlers.js",
      "src/saveCrackWorker.js",
      "src/timelineRowWorker.js",
      "src/fileHandlers.js",
      "src/folderImportHandlers.js",
      "src/modPathResolver.js",
      "src/logWatchHandlers.js",
      "src/regionOwnersCsvHandler.js",
      "src/saveListHandlers.js",
      "src/factionDisplayHandlers.js",
      "src/modDataLoader.js",
      "src/parseSaveData.js",
      "src/parseSaveDataWorker.js",
      "src/saveDiff.js",
      "src/mainUtils.js",
      "src/iconDirCache.js",
      "src/iconPngCache.js",
      "src/submodDrift.js",
      "src/submodDriftHandlers.js",
      "src/incomeExplainHandlers.js",
      "src/econBaseline.js",
      "src/econBaselineHandlers.js",
      "src/reportExportHandlers.js",
      "src/saveCompare.js",
      "src/saveCompareHandlers.js",
      "src/saveCompareWorker.js",
      "src/campaignAutopsy.js",
      "src/campaignAutopsyHandlers.js",
      "src/buildOrder.js",
      "src/buildOrderHandlers.js",
      "src/modLint.js",
      "src/modLintHandlers.js",
      "src/popProjection.js",
      "src/popProjectionHandlers.js",
      "src/definitionLocator.js",
      "src/definitionLocatorHandlers.js",
      "src/whatIfSandbox.js",
      "src/whatIfHandlers.js",
      "src/turnParser.js",
      "src/diagnostics.js",
      "src/startingArmiesBuilder.js",
      "src/economyParser.js",
      "src/parsers.js"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "extraResources": [
      {
        "from": "scripts-suite-py",
        "to": "app_data"
      },
      {
        "from": "python-runtime",
        "to": "python-runtime"
      },
      {
        "from": "bundled-mod",
        "to": "bundled-mod"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Tarnholm",
        "repo": "Provincia",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "shortcutName": "Provincia",
      "guid": "com.tarnholm.interactive-map"
    }
  }
}
