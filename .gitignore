# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# Bundled runtime artifacts for the embedded Scripts feature — fetched by
# scripts/fetch-runtime.js (prebuild), not committed. See main-scripts.js.
/python-runtime
/scripts-suite/vs

# local working copies / scratch dirs not meant for the repo
/for claude/
/cd
/ci
/robocopy
/run

# Sample save files used for parser reverse-engineering — never committed
/sample-*.sav
*.sav

# Parser reverse-engineering scratch dir (diagnostics, trace scripts,
# intermediate findings). Not production code.
/calibration

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code local config — must NEVER hit this public repo
/.claude/

# Python bytecode cache for embedded Scripts suite
__pycache__/

# Parser reverse-engineering scratch (ad-hoc probe scripts, not production)
/tmp/

# Generated treasury run outputs (regenerated by the Scripts suite)
/derived/treasury_for_upload/
/derived/treasury_run_imperial/

tmp-*.json
tmp_*
_scratch/

# Generated outputs of the Python Scripts suite (regenerated each run)
/scripts-suite-py/processed_output/

# Regenerated descr_strat exports (named after local save files)
/derived/*.txt

# Crash-reporter source is deliberately NOT tracked here.
# It carries the live Discord webhook in plaintext; this repo is PUBLIC, and
# committing it in v0.9.1438 got the webhook auto-revoked by Discord (GitHub
# secret scanning), which silently killed report uploads for every tester.
# Master copy lives in ..\RIS-CrashReporter and is copied in before packaging.
/crash-reporter/*.py
/crash-reporter/crash_reporter.ini.example
